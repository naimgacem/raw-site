# Where cash-on-delivery orders are sent. Set at least one (locally in .env.local, or in Vercel → Settings → Environment Variables).

# 1) Telegram (recommended, free): talk to @BotFather → /newbot → copy the token.
#    Then send any message to your bot and open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) Any webhook receiving JSON — e.g. a Google Apps Script web app that appends rows to a Google Sheet (see README).
ORDER_WEBHOOK_URL=
