# Copy to .env.local for your computer, or add each one in Vercel → Settings → Environment Variables.
# Nothing here is needed to try the site locally: the admin password is "admin" and data is saved in .data/.

# ── Admin ─────────────────────────────────────────────────────────────────────
# Password for /admin (you can change it later from Admin → Settings).
ADMIN_PASSWORD=
# Optional: a long random string that signs the login cookie. Changing it logs everyone out.
ADMIN_SECRET=

# ── Database (Supabase, free) — see README → Admin setup ─────────────────────
# Supabase → Project Settings → API: "Project URL" and the "service_role" secret key.
# The service_role key is secret: never put it in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Order notifications on your phone (optional, recommended) ────────────────
# 1) Telegram (free): talk to @BotFather → /newbot → copy the token.
#    Then send any message to your bot and open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) Any webhook receiving JSON — e.g. a Google Apps Script web app that appends rows to a Google Sheet (see README).
ORDER_WEBHOOK_URL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Your real domain, used for links and social previews.
NEXT_PUBLIC_SITE_URL=
# Vercel sets this for the daily database keep-alive if you add it; any random string.
CRON_SECRET=
